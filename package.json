{
  "name": "@talocode/statuslane",
  "version": "0.1.1",
  "description": "Open-source uptime monitoring, incident tracking, and status pages for developers and agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "statuslane": "dist/cli.js", "statuslane-mcp": "dist/mcp.js", "statuslane-server": "dist/server.js" },
